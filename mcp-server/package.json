{
  "name": "@barlore/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Barlore strength training knowledge base",
  "main": "src/index.ts",
  "bin": {
    "barlore-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "dev": "tsx --watch src/index.ts",
    "dev:http": "tsx --watch src/index.ts --http",
    "prebuild:worker": "mkdir -p data && cp ../index/exercises.json ../index/muscle_index.json ../index/programs.json data/",
    "deploy": "npm run prebuild:worker && wrangler deploy"
  },
  "keywords": ["mcp", "strength-training", "barlore"],
  "author": "hollis",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
